# Ollama API key — create one at https://ollama.com/settings/keys
OLLAMA_API_KEY=your-ollama-api-key

# Ollama model (optional — defaults to deepseek-v4.1-flash)
# OLLAMA_MODEL=deepseek-v4.1-flash

# Ollama host (optional — defaults to https://ollama.com for Ollama Cloud)
# OLLAMA_HOST=http://localhost:11434

FAL_KEY=your-fal-key
STITCH_API_KEY=your-stitch-key

# Optional: GitHub token for the Code Map box (functions).
# Public repositories are read without it; a token unlocks private repos and raises
# the API rate limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=
